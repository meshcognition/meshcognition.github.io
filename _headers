/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Astro emits content-hashed filenames under /_astro/* — safe to cache
# forever (filename changes when content changes, so no stale-content risk).
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Image assets — 7 day cache (no automatic content-hashing).
/image/*
  Cache-Control: public, max-age=604800

# HTML pages — short cache so content updates propagate quickly.
/*.html
  Cache-Control: public, max-age=300, must-revalidate

/
  Cache-Control: public, max-age=300, must-revalidate
